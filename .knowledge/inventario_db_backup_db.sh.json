{"is_source_file": true, "format": "bash script", "description": "This is a Bash script that checks for the presence of different database systems (SQLite, PostgreSQL, MySQL, MongoDB) running on the system and performs backups accordingly. It includes logic to detect database types, verify their status, and execute backup commands, saving backup files with appropriate naming conventions.", "external_files": ["/usr/lib/postgresql/${PG_VERSION}/bin/pg_isready", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "pg_dump", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "${PG_BIN}/pg_dump -h localhost -p ${DB_PORT} -U ${DB_USER} -d ${DB_NAME} --clean --if-exists --create", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup script", "SQLite backup", "PostgreSQL backup", "MySQL backup", "MongoDB backup", "database detection script"], "state": 2, "file_id": 2, "knowledge_revision": 12, "git_revision": "1779bc4653d116727c21ad267030a16e4f2d6cb4", "hash": "7af9aa35fa4940f934d83